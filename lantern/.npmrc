# npm resolution settings for Olympus.
#
# WHY `legacy-peer-deps` IS ON
# -----------------------------
# typescript-eslint@8.71 declares a peer range of `typescript >=4.8.4 <6.1.0`, and it
# throws on import when it loads against TypeScript 7. The project is deliberately on
# TypeScript 7 (the native port) and typechecks clean on it, so downgrading the compiler
# to satisfy a linter's peer range would be the wrong trade.
#
# The conflict is real but harmless here, and it is handled deliberately in one place:
# `eslint.config.js` patches `require('typescript')` to resolve to the `ts6` alias
# (TypeScript 6) for the duration of loading the ESLint packages, so the linter never
# sees TypeScript 7. Nothing else in the repo resolves `typescript` from that path.
# `npm run typecheck` remains the type authority, on TypeScript 7.
#
# Without this setting `npm install` needs an explicit --legacy-peer-deps flag AND
# `npm ci` fails outright with ERESOLVE -- which broke CI on its first step. Setting it
# in .npmrc makes local installs and CI resolve identically, so nobody has to remember
# a flag.
#
# WHEN TO DELETE THIS FILE
# ------------------------
# Delete it once typescript-eslint ships TypeScript 7 support (upstream
# typescript-eslint#10940) and `ts6` is removed from devDependencies. Check that
# `npm ci` and `npm run lint` both still pass before deleting.
legacy-peer-deps=true

# Reproducible, auditable installs: fail rather than silently hoisting a dependency to
# the top of node_modules, which is a class of bug that only shows up in someone's build.
fund=false
audit=true
