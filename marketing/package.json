{
  "name": "kern-marketing",
  "private": true,
  "version": "0.1.0",
  "description": "An agent that plans, schedules and posts Kern's Instagram content and handles comments. Free to run, no dependencies.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "plan": "node src/cli.mjs plan",
    "publish": "node src/cli.mjs publish",
    "engage": "node src/cli.mjs engage",
    "report": "node src/cli.mjs report",
    "approve": "node src/cli.mjs approve",
    "status": "node src/cli.mjs status",
    "capture": "node src/capture.mjs",
    "test": "node --test tests/*.test.mjs"
  }
}
